#: ../sites/mdrive/data/other.py:7 ../sites/mdrive/data/other.py:14
msgid ""
"mDrive - Контроллер для шагового и BLDC двигателя, позволяющий с высокой скоростью и "
"точностью управлять движениями."
msgstr ""
"mDrive - Controller for stepper and BLDC motors, allowing you to control movements with "
"high speed and accuracy."

#: ../sites/mdrive/data/other.py:11
msgid "Программное обеспеченье для mDrive"
msgstr "Software for mDrive"

#: ../sites/mdrive/data/other.py:18 ../sites/mdrive/data/products.py:8
msgid "mDrive"
msgstr "mDrive"

#: ../sites/mdrive/data/products.py:10 ../sites/mdrive/data/products.py:14
msgid ""
"Контроллер для шагового и BLDC двигателя, позволяющий с высокой скоростью и точностью "
"управлять движениями."
msgstr ""
"Controller for stepper and BLDC motors, allowing you to control movements with high "
"speed and accuracy."

#: ../sites/mdrive/data/products.py:18 ../sites/mdrive/data/products.py:23
msgid "Количество осей: 1 - 3"
msgstr "Axis: 1-3"

#: ../sites/mdrive/data/products.py:19
msgid "Три режима деления шага"
msgstr "3 step modes"

#: ../sites/mdrive/data/products.py:20
msgid "Скорость: до 15000 полных шагов/сек"
msgstr "Speed: up to 15000 full steps per second"

#: ../sites/mdrive/data/products.py:24
msgid "Система питания: единая на все 3 оси"
msgstr "Power supply system: unified for all 3 axes"

#: ../sites/mdrive/data/products.py:25
msgid "Поддерживаемые типы двигателей: биполярный шаговый, BLDC"
msgstr "Supported engine types: bipolar stepper, BLDC"

#: ../sites/mdrive/data/products.py:26
msgid "Номинальный ток в обмотке шагового/BLDC двигателя: до 3 А"
msgstr "Rated current in the winding of the stepper motor/BLDC: up to 3 A"

#: ../sites/mdrive/data/products.py:27
msgid "Режим деления шага: полношаговый, 1/2, 1/256"
msgstr "Step modes: full-step, 1/2, 1/256"

#: ../sites/mdrive/data/products.py:28
msgid "Максимальная скорость: до 15 000 полных шагов/сек"
msgstr "Maximum speed: up to 15 000 full steps per second"

#: ../sites/mdrive/data/products.py:29
msgid "Диапазон напряжения питания: 12 - 48 В"
msgstr "Supply voltage range: 12 - 48 V"

#: ../sites/mdrive/data/products.py:30
msgid "Количество цифровых входов/выходов: 3 входа, 1 выход (EXTIO)"
msgstr "Number of digital inputs/outputs: 3 inputs, 1 output (EXTIO)"

#: ../sites/mdrive/data/products.py:31
msgid ""
"Система синхронизации: внутренняя (общая для всех осей, для возможности создания "
"связанного движения по траектории) и внешняя (индивидуальная для каждой оси)"
msgstr ""
"Synchronization supply system: internal (common to all axes, for the possibility of "
"creating a connected motion along the trajectory) and external (individual for each "
"axis)"

#: ../sites/mdrive/data/products.py:33
msgid ""
"Возможность задавать напряжение: от 5 до 24 В для выходов EXTIO, SYNC, EMBRAKE (зависит "
"от напряжения, поданного на EXT REF SUPPLY)"
msgstr ""
"Possibility to set the voltage of the output signals according to the user’s purposes: "
"from 5 to 24 V for EXTIO, SYNC, EMBRAKE outputs (depends on the voltage applied to EXT "
"REF SUPPLY)"

#: ../sites/mdrive/data/products.py:35
msgid "Подключение к ПК: через USB или Ethernet"
msgstr "Connecting to a PC: via USB or Ethernet"

#: ../sites/mdrive/data/products.py:36
msgid "Габариты контроллера: 155 х 112 х 59 мм"
msgstr "Controller dimensions: 155 x 112 x 59 mm"

#: ../sites/mdrive/data/products.py:37
msgid ""
"Вес контроллера:<br>Одноосный контроллер: 0.533 кг<br>Двухосный контроллер: 0.603 "
"кг<br>Трехосный контроллер: 0.669 кг"
msgstr ""
"Controller weights:<br>One-axis controller 533 g<br>Two-axis controller 603 g<br>Three-"
"axis controller 669 g"

#: ../sites/mdrive/data/products.py:41
msgid ""
"Совместимость с типами ОС: Windows (7, 8, 10, 11), Linux , MacOS Sierra и новее для "
"Intel и Apple Silicon (с использованием Rosetta 2)"
msgstr ""
"Compatibility with OS types: Windows (XP SP3, Vista, 7, 8, 10, 11), Linux, Mac OS for "
"intel, including\n"
"64-bit versions and Apple Silicon (using Rosetta 2)"

#: ../sites/mdrive/data/products.py:43
msgid "Графический интерфейс: mDrive Direct Control"
msgstr "A user-friendly graphical interface: mDrive Direct Control"

#: ../sites/mdrive/data/products.py:44
msgid ""
"Возможность программного управления: контроллер поставляется с кросс-платформенной "
"библиотекой и примерами, которые позволяют быстро начать программирование с "
"использованием C/C++, C#, Python, Delphi, Java, LabView, Matlab, VB.NET"
msgstr ""
"Programming language supports: the controller comes with a cross-platform library and "
"examples that allow you to quickly start programming using C/C++, C#, Python Delphi, "
"Java, LabView, Matlab, VB.NET"

